{
  "manifest_version": 3,
  "name": "QR Code Generator",
  "version": "1.1",
  "description": "Generate a QR code for the current site URL with favicon, history, and export options.",
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  },
  "commands": {
    "generate_qr": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Generate QR Code for current tab"
    }
  }
}
